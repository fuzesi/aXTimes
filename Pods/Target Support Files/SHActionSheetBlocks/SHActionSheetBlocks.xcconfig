CONFIGURATION_BUILD_DIR = $PODS_CONFIGURATION_BUILD_DIR/SHActionSheetBlocks
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = "${PODS_ROOT}/Headers/Private" "${PODS_ROOT}/Headers/Private/SHActionSheetBlocks" "${PODS_ROOT}/Headers/Public" "${PODS_ROOT}/Headers/Public/CSV" "${PODS_ROOT}/Headers/Public/Crashlytics" "${PODS_ROOT}/Headers/Public/Fabric" "${PODS_ROOT}/Headers/Public/MEAlertView" "${PODS_ROOT}/Headers/Public/SHActionSheetBlocks" "${PODS_ROOT}/Headers/Public/TTOpenInAppActivity" "${PODS_ROOT}/Headers/Public/UAAppReviewManager"
PODS_BUILD_DIR = $BUILD_DIR
PODS_CONFIGURATION_BUILD_DIR = $PODS_BUILD_DIR/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_ROOT = ${SRCROOT}
PODS_TARGET_SRCROOT = ${PODS_ROOT}/SHActionSheetBlocks
PRODUCT_BUNDLE_IDENTIFIER = org.cocoapods.${PRODUCT_NAME:rfc1034identifier}
SKIP_INSTALL = YES
