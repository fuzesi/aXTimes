fastlane_version '2.54.4'

default_platform :ios

platform :ios do
  #
  # Learn more here: https://docs.fastlane.tools/getting-started/ios/beta-deployment/
  #             and: https://docs.fastlane.tools/getting-started/android/beta-deployment/
  #
  lane :beta do |values|
    # Variant 1: Ask for a one line input
    # changelog =  `prompt("Changelog: ") `

    # Variant 2: Ask for a multi-line input
    #   The user confirms their input by typing `END` and Enter
    changelog = prompt(
      text: 'Changelog: ',
      multi_line_end_keyword: 'END'
    )

    # Fabric generated this lane for deployment to Crashlytics Beta
    # set 'export_method' to 'ad-hoc' if your Crashlytics Beta distribution uses ad-hoc provisioning
    gym(scheme: 'aXTimes', export_method: 'ad-hoc', configuration: 'AdHoc', xcargs: '-allowProvisioningUpdates', export_xcargs: '-allowProvisioningUpdates')

    #    emails = values[:test_email] ? values[:test_email] : ['fuesec@gmail.com']  # You can list more emails here
    emails = values[:test_email] ? values[:test_email] : nil # You can list more emails here
    #    groups = values[:test_email] ? nil : ['aximilate_core'] # You can define groups on the web and reference them here
    groups = values[:test_email] ? nil : ['aximilate'] # You can define groups on the web and reference them here

    crashlytics(api_token: '3abfa41374b15d0a34183c7da5c0a7dc0f93cf3c',
                build_secret: 'e80e04c42d0272212e142567a8c679a5097ccaa7577878cec288b3c7516498af',
                emails: nil,
                groups: ['aximilate'],
                notes: changelog, # Check out the changelog_from_git_commits action
                notifications: true) # Should this distribution notify your testers via email?

    clean_build_artifacts()
    # for all available options run `fastlane action crashlytics`

    # You can notify your team in chat that a beta build has been uploaded
    # slack(
    #   slack_url: "https://hooks.slack.com/services/YOUR/TEAM/INFO"
    #   channel: "beta-releases",
    #   message: "Successfully uploaded a beta release - see it at https://fabric.io/_/beta"
    # )
  end
end
